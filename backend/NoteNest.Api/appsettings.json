{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "JsonDb": { "Path": "storage/json.db" },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "MediaStorage": {
    "RootPath": "media-files",
